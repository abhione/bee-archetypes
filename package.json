{
  "name": "bee-archetypes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:data": "tsx scripts/check-archetype-invariants.ts",
    "gen:content": "tsx scripts/generate-archetype-content.ts",
    "typecheck": "tsc -b --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "pnpm build && pnpm build:server",
    "start:server": "node dist-server/index.js",
    "dev:server": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "qa:gate": "tsx scripts/qa-gate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@clerk/backend": "^3.16.13",
    "@clerk/clerk-react": "^5.20.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.62.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "hono": "^4.13.5",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@10.23.0"
